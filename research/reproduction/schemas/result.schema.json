{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pqtc.reproduction.result.schema.v1",
  "title": "PQTC reproduction CLI envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "result"],
      "properties": {
        "ok": {"const": true},
        "result": {"type": ["object", "array", "string", "number", "boolean"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "details": {}
          }
        }
      }
    }
  ]
}
