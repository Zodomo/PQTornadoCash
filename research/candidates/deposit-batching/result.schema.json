{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sp12-deposit-batching-v1",
  "type": "object",
  "required": ["schema", "candidate", "status", "batch_sizes", "transition_relation", "safety", "decision"],
  "properties": {
    "schema": {"const": "sp12-deposit-batching-v1"},
    "candidate": {"const": "SP-12"},
    "batch_sizes": {"const": [8, 16, 32, 64, 256]},
    "safety": {
      "type": "object",
      "required": ["all_mutations_reject"],
      "properties": {"all_mutations_reject": {"const": true}}
    },
    "decision": {
      "type": "object",
      "required": ["candidate", "operator_assumption"],
      "properties": {
        "candidate": {"const": "DEFERRED/STOP"},
        "operator_assumption": {"const": "NONE; no trusted or always-online operator"}
      }
    }
  }
}
