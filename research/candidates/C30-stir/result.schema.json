{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqtornado.invalid/research/C30-stir/result.schema.json",
  "title": "C30 pinned upstream TwoAdicStirPcs non-hiding result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "candidate_id", "spike_id", "status", "evidence_class", "measurement_label", "upstream", "compiled_api_checks", "proxy_geometry", "verified", "proof_bytes", "proof_sha256", "commit_time_ns", "open_time_ns", "native_verify_time_ns", "peak_rss_bytes", "relation_gate", "privacy_finalist", "pqtc_measurement"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"const": "C30"},
    "spike_id": {"const": "SP-52"},
    "status": {"const": "BENCHMARK_ONLY"},
    "evidence_class": {"const": "UPSTREAM_BASELINE_NOT_PQTC"},
    "measurement_label": {"const": "UPSTREAM_BASELINE_NOT_PQTC"},
    "upstream": {
      "type": "object",
      "required": ["commit", "api", "source_hashes_verified_by_runner"],
      "properties": {
        "commit": {"const": "3152b14a89067c83775a8076cc262ffc48a1fd7c"},
        "api": {"const": "TwoAdicStirPcs"},
        "source_hashes_verified_by_runner": {"const": true}
      }
    },
    "compiled_api_checks": {
      "type": "object",
      "required": ["two_adic_stir_pcs", "zk", "hiding"],
      "properties": {
        "two_adic_stir_pcs": {"const": true},
        "zk": {"const": false},
        "hiding": {"const": false}
      }
    },
    "proxy_geometry": {
      "type": "object",
      "required": ["public_data", "log_degree", "polynomial_elements", "matrix_width", "opened_points", "matched_with_candidate", "implements_frozen_pqtc_relation"],
      "properties": {
        "public_data": {"const": true},
        "log_degree": {"const": 12},
        "polynomial_elements": {"const": 4096},
        "matrix_width": {"const": 1},
        "opened_points": {"const": 1},
        "matched_with_candidate": {"const": "C20"},
        "implements_frozen_pqtc_relation": {"const": false}
      }
    },
    "verified": {"const": true},
    "proof_bytes": {"type": "integer", "minimum": 1},
    "proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit_time_ns": {"type": "integer", "minimum": 1},
    "open_time_ns": {"type": "integer", "minimum": 1},
    "native_verify_time_ns": {"type": "integer", "minimum": 1},
    "peak_rss_bytes": {"type": "integer", "minimum": 1},
    "relation_gate": {
      "type": "object",
      "required": ["accepted_sp10_relation_available", "control_relation", "upstream_smoke_implements_relation"],
      "properties": {
        "accepted_sp10_relation_available": {"const": false},
        "control_relation": {"const": "frozen-v0.3/H0"},
        "upstream_smoke_implements_relation": {"const": false}
      }
    },
    "privacy_finalist": {"const": false},
    "pqtc_measurement": {"const": false}
  }
}
