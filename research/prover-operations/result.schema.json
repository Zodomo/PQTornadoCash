{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pqtc/sp-73-prover-operations-result.schema.json",
  "title": "PQTC SP-73 prover operations result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "studyId",
    "candidateId",
    "evidenceDisposition",
    "inputValidation",
    "h1",
    "platformsAndBuilds",
    "workflows",
    "cliWorkflow",
    "operationalPrivacy",
    "gate",
    "perRun"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "studyId": { "const": "SP-73" },
    "candidateId": { "const": "C00/v03-baseline" },
    "evidenceDisposition": { "const": "BASELINE_OPERATIONS_ONLY_NO_FINALIST" },
    "inputValidation": { "$ref": "#/$defs/inputValidation" },
    "h1": { "$ref": "#/$defs/h1" },
    "platformsAndBuilds": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/statusItem" }
    },
    "workflows": { "$ref": "#/$defs/workflows" },
    "cliWorkflow": { "$ref": "#/$defs/cliWorkflow" },
    "operationalPrivacy": { "$ref": "#/$defs/privacy" },
    "gate": { "$ref": "#/$defs/gate" },
    "perRun": {
      "type": "array",
      "minItems": 60,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "decimalDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimum", "median", "p90_nearest_rank", "p95_nearest_rank", "p99_nearest_rank", "maximum", "mean_rounded_12_places", "population_standard_deviation_rounded_12_places"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "median": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "p90_nearest_rank": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "p95_nearest_rank": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "p99_nearest_rank": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "maximum": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "mean_rounded_12_places": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "population_standard_deviation_rounded_12_places": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }
      }
    },
    "integerDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimum", "median", "p90_nearest_rank", "p95_nearest_rank", "p99_nearest_rank", "maximum", "mean_rounded_12_places", "population_standard_deviation_rounded_12_places"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "integer", "minimum": 0 },
        "median": { "type": "integer", "minimum": 0 },
        "p90_nearest_rank": { "type": "integer", "minimum": 0 },
        "p95_nearest_rank": { "type": "integer", "minimum": 0 },
        "p99_nearest_rank": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 },
        "mean_rounded_12_places": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "population_standard_deviation_rounded_12_places": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }
      }
    },
    "inputValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "benchmarkRunSchema", "sourceRecordsValidated", "expectedSourceRecords", "artifactsSizeAndSha256Validated", "artifactBytesValidated", "runIdsUniqueAndComplete", "baselineCommitUniform", "hardwareProfile"],
      "properties": {
        "status": { "const": "PASS" },
        "benchmarkRunSchema": { "const": "benchmark-run.schema.json" },
        "sourceRecordsValidated": { "type": "integer", "minimum": 60 },
        "expectedSourceRecords": { "const": 60 },
        "artifactsSizeAndSha256Validated": { "type": "integer", "minimum": 480 },
        "artifactBytesValidated": { "type": "integer", "minimum": 1 },
        "runIdsUniqueAndComplete": { "const": true },
        "baselineCommitUniform": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "hardwareProfile": { "const": "research/harness/hardware-detect/h1-m4-max.json" }
      }
    },
    "h1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hardwareClass", "profileHardwareId", "runRecordHardwareId", "profileAndRecordsMatchOn", "arm64NeonHardwareCapability", "neonCodePathExecution", "cold", "warm"],
      "properties": {
        "status": { "const": "PARTIALLY_MEASURED" },
        "hardwareClass": { "const": "H1_CONTINUITY" },
        "profileHardwareId": { "type": "string", "minLength": 1 },
        "runRecordHardwareId": { "type": "string", "minLength": 1 },
        "profileAndRecordsMatchOn": { "type": "array", "minItems": 5, "items": { "type": "string" } },
        "arm64NeonHardwareCapability": { "const": "MEASURED_BY_HARDWARE_PROFILE" },
        "neonCodePathExecution": { "const": "NOT_EVALUATED" },
        "cold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count", "reason"],
          "properties": {
            "status": { "const": "NOT_EVALUATED" },
            "count": { "const": 0 },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "warm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count", "wallMs", "proofOnlyMs", "nativeVerifyMs", "peakRssBytes"],
          "properties": {
            "status": { "const": "MEASURED" },
            "count": { "const": 60 },
            "wallMs": { "$ref": "#/$defs/decimalDistribution" },
            "proofOnlyMs": { "$ref": "#/$defs/decimalDistribution" },
            "nativeVerifyMs": { "$ref": "#/$defs/decimalDistribution" },
            "peakRssBytes": { "$ref": "#/$defs/integerDistribution" }
          }
        }
      }
    },
    "statusItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PARTIALLY_MEASURED", "NOT_EVALUATED"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "workflowStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setupAndPrecomputation", "cancellation", "progress", "memoryPressure", "crashRecovery", "cpuTime", "diskUsage", "serializationAndUpload"],
      "properties": {
        "setupAndPrecomputation": { "$ref": "#/$defs/workflowStatus" },
        "cancellation": { "$ref": "#/$defs/workflowStatus" },
        "progress": { "$ref": "#/$defs/workflowStatus" },
        "memoryPressure": { "$ref": "#/$defs/workflowStatus" },
        "crashRecovery": { "$ref": "#/$defs/workflowStatus" },
        "cpuTime": { "$ref": "#/$defs/workflowStatus" },
        "diskUsage": { "$ref": "#/$defs/workflowStatus" },
        "serializationAndUpload": { "$ref": "#/$defs/workflowStatus" }
      }
    },
    "cliWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gateCredit", "specification", "reason"],
      "properties": {
        "status": { "const": "SPECIFICATION_ONLY_NOT_IMPLEMENTED" },
        "gateCredit": { "const": false },
        "specification": { "const": "research/prover-operations/cli-workflow.json" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review", "crossUserAggregatorWitnessPolicy", "productionWitnessService", "secureWitnessIsolation", "attestation", "productionLocalFallback"],
      "properties": {
        "status": { "const": "REVIEWED_WITH_OPEN_PRODUCTION_GAPS" },
        "review": { "const": "research/prover-operations/privacy-review.json" },
        "crossUserAggregatorWitnessPolicy": { "const": "PROOFS_AND_PUBLIC_STATEMENTS_ONLY_NEVER_WITNESSES" },
        "productionWitnessService": { "const": "NOT_PROPOSED" },
        "secureWitnessIsolation": { "const": "NOT_EVALUATED" },
        "attestation": { "const": "NOT_EVALUATED" },
        "productionLocalFallback": { "const": "NOT_EVALUATED" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rule", "blockingIds", "securityQualified", "finalistSelected"],
      "properties": {
        "status": { "const": "FAIL" },
        "rule": { "type": "string", "minLength": 1 },
        "blockingIds": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } },
        "securityQualified": { "const": false },
        "finalistSelected": { "const": false }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "classification", "wallMs", "proofOnlyMs", "nativeVerifyMs", "peakRssBytes", "rawProofBytes", "abiCalldataBytes", "retainedArtifactBytes"],
      "properties": {
        "runId": { "type": "string", "pattern": "^v03-(?:corpus|fixed)-[0-9]{2}$" },
        "classification": { "const": "WARM" },
        "wallMs": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "proofOnlyMs": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "nativeVerifyMs": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "peakRssBytes": { "type": "integer", "minimum": 1 },
        "rawProofBytes": { "type": "integer", "minimum": 1 },
        "abiCalldataBytes": { "type": "integer", "minimum": 1 },
        "retainedArtifactBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
