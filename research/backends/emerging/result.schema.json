{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pqtc.emerging.result.schema.json",
  "title": "Emerging backend source-check or reproduction result",
  "type": "object",
  "required": ["schema_version", "candidate_id", "run_type", "evidence_origin", "pqtc_classification", "gate_status"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"enum": ["C50", "C60", "C70"]},
    "run_type": {"type": "string"},
    "evidence_origin": {"enum": ["LOCAL_SOURCE_CHECK_OF_PINNED_UPSTREAM", "LOCAL_REPRODUCTION_OF_PINNED_UPSTREAM"]},
    "pqtc_classification": {
      "enum": [
        "NOT_PQTC_NO_EXACT_RELATION",
        "STANDALONE_WHIR_NOT_SPARTAN_NOT_PQTC",
        "NOT_PQTC_ARCHITECTURE_EVIDENCE_ONLY",
        "UPSTREAM_ARCHITECTURE_SMOKE_NOT_PQTC",
        "NOT_PQTC",
        "UPSTREAM_BASELINE_NOT_PQTC",
        "EXPERIMENTAL_UPSTREAM_POC_NOT_PQTC"
      ]
    },
    "execution_status": {"enum": ["COMPLETED", "FAILED", "NOT_EVALUATED"]},
    "blocker": {
      "type": "object",
      "required": ["kind", "executable"],
      "properties": {
        "kind": {"const": "MISSING_PREREQUISITE"},
        "executable": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gate_status": {},
    "exit_code": {"type": "integer"}
  },
  "additionalProperties": true
}
