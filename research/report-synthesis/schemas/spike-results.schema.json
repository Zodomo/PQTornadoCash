{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pqtc.sp90.result.v1",
  "title": "SP-90 synthesis result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "spike", "research_cutoff", "evidence_boundary", "scorecard_count",
    "scorecard_index", "pareto_axes", "weight_sets", "sensitivity", "stop_rule_catalog",
    "decision", "recommendation_token", "decision_evidence", "consistency"
  ],
  "properties": {
    "schema": {"const": "pqtc.sp90.result.v1"},
    "spike": {"const": "SP-90"},
    "research_cutoff": {"const": "2026-09-04"},
    "evidence_boundary": {"type": "object"},
    "scorecard_count": {"type": "integer", "minimum": 1},
    "scorecard_index": {"type": "array", "minItems": 1},
    "pareto_axes": {"type": "array", "minItems": 8, "maxItems": 8},
    "weight_sets": {"type": "array", "minItems": 4},
    "sensitivity": {"type": "object"},
    "stop_rule_catalog": {"type": "array", "minItems": 10, "maxItems": 10},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "label", "hard_gate_winners", "eligible_finalists"],
      "properties": {
        "outcome": {"const": "OUTCOME_D"},
        "label": {"const": "no new full build yet"},
        "hard_gate_winners": {"const": []},
        "eligible_finalists": {"const": []}
      }
    },
    "recommendation_token": {"const": "RECOMMEND_ADDITIONAL_TARGETED_RESEARCH"},
    "decision_evidence": {"type": "array", "minItems": 5},
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_1_forbids_integration", "checkpoint_2_authorizes_no_bundle", "checkpoint_3_empty_integration_scope", "checkpoint_4_selects_no_product", "sp80_zero_eligible", "weighted_scores_cannot_override_gates", "null_is_not_zero", "false_finalist_count"],
      "properties": {
        "checkpoint_1_forbids_integration": {"const": true},
        "checkpoint_2_authorizes_no_bundle": {"const": true},
        "checkpoint_3_empty_integration_scope": {"const": true},
        "checkpoint_4_selects_no_product": {"const": true},
        "sp80_zero_eligible": {"const": true},
        "weighted_scores_cannot_override_gates": {"const": true},
        "null_is_not_zero": {"const": true},
        "false_finalist_count": {"const": 0}
      }
    }
  }
}
